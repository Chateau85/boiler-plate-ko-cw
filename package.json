{
  "name": "boiler-plate",
  "version": "1.0.0",
  "description": "Secure MERN authentication study application",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "backend": "nodemon server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently --kill-others-on-fail \"npm run backend\" \"npm run client\"",
    "test": "node --test \"test/*.test.js\"",
    "test:client": "npm test --prefix client",
    "build": "npm run build --prefix client"
  },
  "author": "cheolwoo",
  "license": "ISC",
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14"
  }
}
